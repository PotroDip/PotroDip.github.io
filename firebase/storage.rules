rules_version = '2';

// পত্রদ্বীপ — Firebase Storage নিয়ম
// Firebase কনসোল → Storage → Rules-এ পুরোটা কপি করে বসিয়ে Publish করুন।
// • ছবি সবাই দেখতে পারে (ওয়েবসাইটে দেখানোর জন্য)
// • আপলোড শুধু লগইন করা ইউজার, শুধু নিজের ফোল্ডারে (media/<নিজের uid>/...)
// • শুধু ছবি (সর্বোচ্চ ১০ MB) ও PDF (সর্বোচ্চ ২০ MB)
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{uid}/{rest=**} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.email_verified == true
                    && ((request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
                        || (request.resource.contentType == 'application/pdf' && request.resource.size < 20 * 1024 * 1024));
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow update: if false;
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
